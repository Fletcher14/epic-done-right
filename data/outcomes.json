{
  "_note": "Synthetic. Hospital visit outcomes for patient-lookup-portal (part 3). Kept apart from patients.json so the original roster -- which continuity-layer and the pre-arrival board depend on -- is untouched. Every visit exists to pose a problem the portal must handle.",
  "_scenarios": {
    "enc-0417": "comorbidities coded beside the admission diagnosis; a treatment linked only to a hidden comorbidity",
    "enc-0421": "the straightforward case -- chest pain presenting, STEMI confirmed, PCI",
    "enc-0430": "one of TWO visits for pt-003 within 24 hours of the same handover -> could not be confirmed",
    "enc-0438": "the second pt-003 visit that makes enc-0430 ambiguous",
    "enc-0802": "a visit behind a call older than 30 days",
    "enc-0902": "reached through a nickname on the ePCR ('Dan') plus a matching MRN",
    "enc-0903": "overdose shown, underlying opioid dependence withheld, psychiatric disposition coarsened",
    "enc-0901": "every diagnosis protected -> 'not shared'",
    "enc-0906": "patient unidentified at handoff, identified by the hospital later (temporary MRN)",
    "enc-0904": "a STRANGER's visit -- only shown if the link rule wrongly attached a first-time patient",
    "enc-0907": "stroke confirmed, tPA given -- still admitted",
    "enc-0909": "still admitted on a provisional diagnosis -> final diagnosis not yet available"
  },
